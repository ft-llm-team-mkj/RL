#!/bin/bash
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=02:00:00
#PBS -P gch51701

cd ${PBS_O_WORKDIR}

set -euo pipefail

# Load modules if on ABCI
if [ -f /etc/profile.d/modules.sh ]; then
    source /etc/profile.d/modules.sh
    module load cuda/12.6/12.6.1
    module load cudnn/9.5/9.5.1
    module load nccl/2.23/2.23.4-1
fi

# Load environment variables from .env
export PATH=$HOME/.local/bin:$PATH
if [ -f .env ]; then
    export $(grep -v '^#' .env | xargs)
fi

# Enable real-time output
export PYTHONUNBUFFERED=1

# Convert GPU UUID to index if needed
# vLLM doesn't support UUID format (GPU-xxxx), need numeric indices
if [ -n "${CUDA_VISIBLE_DEVICES:-}" ]; then
    if [[ $CUDA_VISIBLE_DEVICES == *GPU-* ]]; then
        echo "Original CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"

        # Get mapping of UUID to index
        declare -A UUID_TO_INDEX
        INDEX=0
        while IFS= read -r line; do
            UUID=$(echo "$line" | grep -oP 'GPU-[a-f0-9-]+')
            if [ -n "$UUID" ]; then
                UUID_TO_INDEX[$UUID]=$INDEX
                INDEX=$((INDEX + 1))
            fi
        done < <(nvidia-smi -L)

        # Convert each UUID to index
        NEW_DEVICES=""
        IFS=',' read -ra UUIDS <<< "$CUDA_VISIBLE_DEVICES"
        for UUID in "${UUIDS[@]}"; do
            UUID=$(echo "$UUID" | xargs)  # trim whitespace
            if [ -n "${UUID_TO_INDEX[$UUID]:-}" ]; then
                if [ -n "$NEW_DEVICES" ]; then
                    NEW_DEVICES="$NEW_DEVICES,${UUID_TO_INDEX[$UUID]}"
                else
                    NEW_DEVICES="${UUID_TO_INDEX[$UUID]}"
                fi
            fi
        done

        if [ -n "$NEW_DEVICES" ]; then
            export CUDA_VISIBLE_DEVICES=$NEW_DEVICES
            echo "Converted CUDA_VISIBLE_DEVICES to indices: $CUDA_VISIBLE_DEVICES"
        else
            # Fallback: use all GPUs
            unset CUDA_VISIBLE_DEVICES
            echo "Could not convert UUIDs, using all GPUs"
        fi
    fi
fi

# Show GPU info
echo "Final CUDA_VISIBLE_DEVICES: ${CUDA_VISIBLE_DEVICES:-unset (all GPUs)}"
nvidia-smi -L

# Configuration via environment variables
# CHECKPOINT_DIR: Input checkpoint directory (required)
# OUTPUT_PATH: Local output path for converted model (required)
# REPO_ID: HuggingFace Hub repository ID (optional, if set will upload to Hub)
# PRIVATE: Set to any value to create private repository (optional)
CHECKPOINT_DIR=${CHECKPOINT_DIR:-""}
OUTPUT_PATH=${OUTPUT_PATH:-"./models/converted"}
REPO_ID=${REPO_ID:-""}
PRIVATE=${PRIVATE:-""}

if [ -z "$CHECKPOINT_DIR" ]; then
    echo "Error: CHECKPOINT_DIR environment variable is required"
    echo "Usage: CHECKPOINT_DIR=results/sft_model/step_1000 qsub convert_to_hf.pbs"
    exit 1
fi

echo "=============================================="
echo "Converting DTensor Checkpoint to HuggingFace Format"
echo "Checkpoint: $CHECKPOINT_DIR"
echo "Output: $OUTPUT_PATH"
if [ -n "$REPO_ID" ]; then
    echo "HuggingFace Hub: $REPO_ID"
    if [ -n "$PRIVATE" ]; then
        echo "Visibility: private"
    else
        echo "Visibility: public"
    fi
else
    echo "HuggingFace Hub: (not uploading)"
fi
echo "Start time: $(date)"
echo "=============================================="

# Create necessary directories
mkdir -p logs "$(dirname "$OUTPUT_PATH")"

# Build command
CMD="uv run python scripts/convert_distcp_to_hf.py"
CMD="$CMD --checkpoint-dir \"$CHECKPOINT_DIR\""
CMD="$CMD --output-path \"$OUTPUT_PATH\""

# Add HuggingFace Hub options if REPO_ID is set
if [ -n "$REPO_ID" ]; then
    CMD="$CMD --repo-id \"$REPO_ID\""
    if [ -n "$PRIVATE" ]; then
        CMD="$CMD --private"
    fi
fi

# Run conversion
echo "Running: $CMD"
eval "$CMD" 2>&1 | tee "logs/convert_to_hf.pbs.o${PBS_JOBID}.realtime"

EXIT_CODE=$?
echo "End time: $(date)"

if [ $EXIT_CODE -eq 0 ]; then
    echo "Conversion completed successfully!"
    echo "Output saved to: $OUTPUT_PATH"
    ls -la "$OUTPUT_PATH" 2>/dev/null || true
else
    echo "Conversion failed (exit code: $EXIT_CODE)"
fi

exit $EXIT_CODE
